# Copy to .env.real-model.local. Never commit the local file or paste its key into chat.
# Recommended default: DeepSeek Chat (OpenAI-compatible JSON Output).
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=CHANGE_ME

# Alibaba Cloud Model Studio alternative:
# LLM_PROVIDER=dashscope
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.7-plus
# LLM_API_KEY=CHANGE_ME

LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
AGENT_TASK_WORKERS=2

# Local retrieval remains available while production Chroma/embedding is prepared.
VECTOR_STORE_PROVIDER=local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EDUPATH_SEED_CORPUS_PATH=data/seed_corpus/seed_documents.jsonl
