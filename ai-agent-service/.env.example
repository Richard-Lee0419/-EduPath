SERVICE_NAME=ai-agent-service
EDUPATH_ENV=dev
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0
VECTOR_STORE_PROVIDER=local
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=edupath_course_chunks
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
AGENT_TASK_WORKERS=2
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_API_KEY=
EMBEDDING_STRICT=false
EMBEDDING_CACHE_DIR=.cache/huggingface
EMBEDDING_DEVICE=
EDUPATH_SEED_CORPUS_PATH=data/seed_corpus/seed_documents.jsonl
MAX_INGEST_BYTES=20971520
