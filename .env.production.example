# Copy this file to .env.production and replace every CHANGE_ME value before deployment.

EDUPATH_IMAGE_TAG=latest
FRONTEND_PORT=80
MAVEN_MIRROR_URL=https://repo.maven.apache.org/maven2
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
PIP_INDEX_URL=https://pypi.org/simple
TORCH_VERSION=2.5.1+cpu
TORCH_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cpu

MYSQL_DATABASE=edupath
MYSQL_USER=edupath
MYSQL_PASSWORD=CHANGE_ME_32_CHAR_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_32_CHAR_ROOT_DB_PASSWORD
MYSQL_PLATFORM=linux/amd64
EXTERNAL_DB_PORT=3306
# EXTERNAL_DB_URL=jdbc:mysql://host.docker.internal:3306/edupath?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHAR_RANDOM_JWT_SECRET
JWT_TTL_SECONDS=86400
JWT_REFRESH_TTL_SECONDS=604800
DEMO_MODE_ENABLED=false

STORAGE_SIGNING_SECRET=CHANGE_ME_AT_LEAST_32_CHAR_STORAGE_SIGNING_SECRET
STORAGE_PROVIDER=oss
OSS_BUCKET=CHANGE_ME_OSS_BUCKET
OSS_ENDPOINT=CHANGE_ME_OSS_ENDPOINT
OSS_KEY_PREFIX=edupath
OSS_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=CHANGE_ME_OSS_ACCESS_KEY_SECRET
STORAGE_LIFECYCLE_DAYS=30
KB_MAX_UPLOAD_BYTES=20971520

# QQ 邮箱 SMTP。开启后注册会发送真实邮件；MAIL_PASSWORD 使用 QQ 邮箱 SMTP 授权码，不是网页登录密码。
EMAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_QQ_EMAIL
MAIL_PASSWORD=CHANGE_ME_QQ_SMTP_AUTH_CODE
MAIL_FROM=
MAIL_FROM_NAME=知径 EduPath
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=CHANGE_ME_OPENAI_COMPATIBLE_BASE_URL
LLM_MODEL=CHANGE_ME_MODEL_NAME
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
AGENT_TASK_WORKERS=2
AI_RESOURCE_TASK_TIMEOUT_SECONDS=180
AI_RESOURCE_TASK_POLL_MILLIS=250
AI_HEALTH_START_PERIOD=300s

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_STRICT=true
EMBEDDING_CACHE_DIR=/tmp/edupath-embeddings
HF_ENDPOINT=
CHROMA_COLLECTION=edupath_course_chunks
EDUPATH_COURSE_CORPUS_DIR=./ai-agent-service/data/seed_corpus
MAX_INGEST_BYTES=20971520
