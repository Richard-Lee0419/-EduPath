# Root service URLs
FRONTEND_PORT=5173
BACKEND_PORT=8080
AI_SERVICE_PORT=8000

# Internal service URLs
VITE_API_BASE_URL=http://localhost:8080/api
BACKEND_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_BASE_URL=http://localhost:8000

# Local dependencies
EDUPATH_ENV=dev
MYSQL_DATABASE=edupath
MYSQL_USER=edupath
MYSQL_PASSWORD=edupath_dev_password
MYSQL_ROOT_PASSWORD=edupath_root_password
DB_URL=jdbc:mysql://localhost:3306/edupath?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=edupath
DB_PASSWORD=edupath_dev_password
REDIS_URL=redis://localhost:6379/0
VECTOR_STORE_PROVIDER=local
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=edupath_course_chunks
KB_MAX_UPLOAD_BYTES=20971520
MAX_INGEST_BYTES=20971520

# Object storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage
OSS_BUCKET=edupath-demo
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_KEY_PREFIX=edupath
STORAGE_SIGNING_SECRET=replace-with-storage-signing-secret
STORAGE_LIFECYCLE_DAYS=30
DEMO_MODE_ENABLED=true

# Security and AI integration
JWT_SECRET=replace-with-local-development-secret
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_API_KEY=
EMBEDDING_STRICT=false
EMBEDDING_CACHE_DIR=.cache/huggingface
EMBEDDING_DEVICE=
EDUPATH_SEED_CORPUS_PATH=ai-agent-service/data/seed_corpus/seed_documents.jsonl
